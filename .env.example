# ==========================================
# VARIÁVEIS DO BACKEND
# ==========================================
MONGO_URI=mongodb://127.0.0.1:27018/marianos_meat
PORT=3020

# Segredo compartilhado com o Squamata-Login (emissor único de identidade).
# Nunca commite o valor real. Sem esta chave o backend não sobe (fail fast).
JWT_SECRET_LOGIN=

# Contexto multi-tenant desta aplicação
APP_SLUG=marianos-meat
DEFAULT_TENANT_ID=default

# ==========================================
# VARIÁVEIS DO FRONTEND (VITE)
# ==========================================
# Copie estas chaves para frontend/.env — o Vite só lê o .env dentro de frontend/.
VITE_API_URL=http://localhost:3020/api/v1
VITE_SSO_URL=http://localhost:5174
VITE_APP_SLUG=marianos-meat
VITE_TENANT_ID=default